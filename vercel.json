{
  "rewrites": [
    {
      "source": "/post/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|TelegramBot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview|redditbot|Googlebot|bingbot|Applebot|Embedly|vkShare|Mastodon|Bluesky|Viber|Iframely|Yahoo! Slurp|DuckDuckBot).*"
        }
      ],
      "destination": "/api/share?post=:id"
    },
    {
      "source": "/profile/:username",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|TelegramBot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview|redditbot|Googlebot|bingbot|Applebot|Embedly|vkShare|Mastodon|Bluesky|Viber|Iframely|Yahoo! Slurp|DuckDuckBot).*"
        }
      ],
      "destination": "/api/share?profile=:username"
    },
    {
      "source": "/projects/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|TelegramBot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview|redditbot|Googlebot|bingbot|Applebot|Embedly|vkShare|Mastodon|Bluesky|Viber|Iframely|Yahoo! Slurp|DuckDuckBot).*"
        }
      ],
      "destination": "/api/share?id=:id"
    },
    {
      "source": "/:slug([a-z0-9-]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|TelegramBot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview|redditbot|Googlebot|bingbot|Applebot|Embedly|vkShare|Mastodon|Bluesky|Viber|Iframely|Yahoo! Slurp|DuckDuckBot).*"
        }
      ],
      "destination": "/api/share?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/(apple-app-site-association|assetlinks.json)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
